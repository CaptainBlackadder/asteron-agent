# Copy this file's variable names into your Vercel project's Environment
# Variables settings (Project → Settings → Environment Variables).
# Do NOT put real values in this file, and do NOT commit a real .env file.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset. Use claude-haiku-4-5-20251001
# for a cheaper/faster model if you're demoing this a lot.
ANTHROPIC_MODEL=claude-sonnet-5
